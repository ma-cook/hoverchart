{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "presence": {
      "$spaceId": {
        // Any authenticated user can read the full presence list for a space
        ".read": "auth != null",
        "$userId": {
          // Authenticated users write their own node; guests write their guest_ prefixed node
          ".write": "auth != null && auth.uid === $userId || $userId.matches(/^guest_.*$/)"
        }
      }
    },
    "chat": {
      "$spaceId": {
        // Any authenticated user can read messages
        ".read": "auth != null",
        "messages": {
          // Any authenticated user can push new messages
          ".write": "auth != null",
          ".indexOn": ["timestamp"],
          "$messageId": {
            // Individual message structure validation
            ".validate": "newData.hasChildren(['userId', 'text', 'timestamp'])"
          }
        }
      }
    }
  }
}
