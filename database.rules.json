{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "presence": {
      "$spaceId": {
        // Any authenticated user can read the full presence list for a space
        ".read": "auth != null",
        "$userId": {
          // Authenticated users write their own node; guests write their guest_ prefixed node
          ".write": "auth != null && auth.uid === $userId || $userId.matches(/^guest_.*$/)"
        }
      }
    },
    "chat": {
      "$spaceId": {
        // Anyone with the spaceId can read messages (guests in public spaces)
        ".read": true,
        "messages": {
          ".indexOn": ["timestamp"],
          "$messageId": {
            // Authenticated users or guests (guest_ prefixed userId) can write
            ".write": "auth != null || newData.child('userId').val().matches(/^guest_.*$/)",
            ".validate": "newData.hasChildren(['userId', 'text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length <= 500"
          }
        }
      }
    }
  }
}
