rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'VsKDyU5XjiNYHzKVuwVanCPd90A2';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // User data and nested collections
    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAuthenticated();
      
      // Original collections
      match /objects/{objectId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /connections/{connectionId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      // Add new spaces collection and its nested collections
      match /spaces/{spaceId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
        
        // Objects within spaces
        match /objects/{objectId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
        
        // Connections within spaces
        match /connections/{connectionId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated() && request.auth.uid == userId;
        }
      }
    }

    // Updates collection
    match /updates/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
