rules_version = '2';

service cloud.firestore {
 match /databases/{database}/documents {
    // Helper functions
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'VsKDyU5XjiNYHzKVuwVanCPd90A2';
    }

    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Fixed function to check if space is shared with user
    function isSpaceSharedWithUser(userId, spaceData) {
      return spaceData != null && 
             spaceData.sharedWith != null && 
             spaceData.sharedWith is list && 
             spaceData.sharedWith.size() > 0 &&
             spaceData.sharedWith.where('userId', '==', userId).size() > 0;
    }
    
    // NEW: Function to check if space is public (shared with "everyone")
    function isPublicSpace(spaceData) {
      return spaceData != null &&
             spaceData.sharedWith != null &&
             spaceData.sharedWith is list &&
             spaceData.sharedWith.hasAny(["everyone"]);
    }
    
    // Simplified function to check if update is valid for shared user
    function isValidSharedUpdate(userId) {
      // Allow ANY update by a shared user - we'll enforce specific rules in the application code
      return true;
    }
    
    // CRITICAL: Allow access to top-level spaces collection
    match /spaces/{spaceId} {
      // Allow read for authenticated users OR if the space is public
      allow read: if isAuthenticated() || isPublicSpace(resource.data);
      
      allow write: if isAuthenticated() && 
                    (resource == null || 
                     resource.data.ownerId == request.auth.uid ||
                     isSpaceSharedWithUser(request.auth.uid, resource.data));
    }

    // Allow access to sharedSpaces collection
    match /sharedSpaces/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Allow access to public spaces collection
    match /publicSpaces/{spaceId} {
      allow read: if true; // Allow anonymous users to read public spaces
      allow write: if isAuthenticated() && 
                    (resource == null || 
                     resource.data.ownerId == request.auth.uid);
    }

    // User data and nested collections
    match /users/{userId} {
      // Allow read access to all authenticated users (needed for shared space discovery)
      allow read: if isAuthenticated();
      
      // Allow write to own user document
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      
      // Personal connections (not in spaces) - keeping for backward compatibility
      match /connections/{connectionId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      // Shared spaces collection
      match /sharedSpaces/{spaceId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      // Spaces owned by this user
      match /spaces/{spaceId} {
        // Allow read for: owner, shared users, or if space is public
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          (resource != null && isSpaceSharedWithUser(request.auth.uid, resource.data)) ||
          (resource != null && isPublicSpace(resource.data))
        );
        
        // Space creation/deletion by owner only
        allow create, delete: if isAuthenticated() && request.auth.uid == userId;
        
        allow update: if isAuthenticated() && (
          request.auth.uid == userId || 
          isSpaceSharedWithUser(request.auth.uid, resource.data)
        );
          // NEW: Allow access to presence subcollection
        match /presence/{presenceId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated(); // Any authenticated user can update their presence
        }
          // NEW: Allow access to signaling subcollection for WebRTC
        match /signaling/{signalingId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated(); // Any authenticated user can write signaling data
        }
        
        // Connections within spaces
        match /connections/{connectionId} {
          // MODIFIED: Allow anonymous access to connections in public spaces
          allow read: if isAuthenticated() || 
                       (get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)) != null &&
                        isPublicSpace(get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)).data));
          
          // Keep write access restricted to authenticated users
          allow write: if isAuthenticated();
        }
          // NEW: Spatial partitioning cells
        match /cells/{cellId} {
          // Allow anonymous access to cells in public spaces
          allow read: if isAuthenticated() || 
                       (get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)) != null &&
                        isPublicSpace(get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)).data));
          
          // Allow authenticated users to create/update cells
          allow create, update: if isAuthenticated() && (
            request.auth.uid == userId || 
            (get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)) != null &&
             isSpaceSharedWithUser(request.auth.uid, get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)).data))
          );
          
          // Only space owner can delete cells
          allow delete: if isAuthenticated() && request.auth.uid == userId;
          
          // Objects within cells (for spatial partitioning)
          match /objects/{objectId} {
            // Allow anonymous access to objects in cells within public spaces
            allow read: if isAuthenticated() || 
                         (get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)) != null &&
                          isPublicSpace(get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)).data));
            
            // Allow authenticated users to write objects in cells
            allow write: if isAuthenticated() && (
              request.auth.uid == userId || 
              (get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)) != null &&
               isSpaceSharedWithUser(request.auth.uid, get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)).data))
            );
          }          // Connections within cells (for spatial partitioning)
          match /connections/{connectionId} {
            // Allow anonymous access to connections in cells within public spaces
            allow read: if isAuthenticated() || 
                         (get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)) != null &&
                          isPublicSpace(get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)).data));
            
            // Allow authenticated users to write connections in cells
            allow write: if isAuthenticated() && (
              request.auth.uid == userId || 
              (get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)) != null &&
               isSpaceSharedWithUser(request.auth.uid, get(/databases/$(database)/documents/users/$(userId)/spaces/$(spaceId)).data))
            );
          }
        }
      }
    }
    
    // Updates collection
    match /updates/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // NEW: Add rules for leave requests collection
    match /leaveRequests/{requestId} {
      // Anyone authenticated can read their own leave requests
      allow read: if isAuthenticated() && 
                   (resource == null || resource.data.userId == request.auth.uid);
      
      // Anyone authenticated can create a leave request for themselves
      allow create: if isAuthenticated() && 
                     request.resource.data.userId == request.auth.uid;
                     
      // Only admins and the space owner can update a leave request
      allow update: if isAuthenticated() && 
                     (isAdmin() || 
                      resource.data.ownerId == request.auth.uid);
                     
      // Only admins can delete leave requests
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Collection group queries - allow authenticated users to query across collections
    match /{path=**}/spaces/{spaceId} {
      allow read: if isAuthenticated();
    }
    
    match /{path=**}/sharedSpaces/{spaceId} {
      allow read: if isAuthenticated();
    }

    // Organizations collection
    match /organizations/{orgId} {
      function isOrgMember(orgData) {
        return orgData.memberIds is list &&
               orgData.memberIds.hasAny([request.auth.uid]);
      }

      function isOrgInvited(orgData) {
        return request.auth.token.email != null &&
               orgData.invitedEmails is list &&
               request.auth.token.email.lower() in orgData.invitedEmails;
      }

      // Owner, members, and invited users can read the organization
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isOrgMember(resource.data) ||
        isOrgInvited(resource.data)
      );

      // Any authenticated user can create an organization (must set themselves as owner)
      allow create: if isAuthenticated() &&
                     request.resource.data.ownerId == request.auth.uid;

      // Owner and members can update the full organization document;
      // invited users may only update the invites, members, and invitedEmails fields (to accept/decline their invite).
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isOrgMember(resource.data) ||
        (isOrgInvited(resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invites', 'members', 'memberIds', 'invitedEmails']))
      );

      // Only the owner can delete the organization
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Organization invites — queryable by the invited user's email
    match /orgInvites/{inviteId} {
      // Invited user can read their own invites
      allow read: if isAuthenticated() &&
                   resource.data.email == request.auth.token.email;

      // Any authenticated user can create (admin creates on behalf of org)
      allow create: if isAuthenticated();

      // Invited user or org members can update invite status (accept/decline)
      allow update: if isAuthenticated() &&
                     resource.data.email == request.auth.token.email;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
